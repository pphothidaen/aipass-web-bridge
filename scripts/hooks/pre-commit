#!/usr/bin/env bash
# Pre-commit hook: Secret scan + Jira ticket validation
set -euo pipefail

ENV_FILE="${HORO_CONSULTANT_ENV:-/Users/kimlenglim/Project/HoroConsultant/.env}"

# Load Jira credentials safely from HoroConsultant .env
# (cron expressions and JSON values break under `set -e`, so extract only JIRA_* keys)
load_jira_env() {
  if [ -f "$ENV_FILE" ]; then
    eval "$(grep -E '^JIRA_(BASE_URL|EMAIL|API_TOKEN)=' "$ENV_FILE" | sed 's/^/export /')"
  fi
}

# Validate Jira ticket exists and is active
# Returns: 0 if valid, 1 if invalid/rejected
validate_jira_ticket() {
  local ticket_id="$1"

  if [ -z "${JIRA_BASE_URL:-}" ] || [ -z "${JIRA_EMAIL:-}" ] || [ -z "${JIRA_API_TOKEN:-}" ]; then
    echo "⚠️  Jira credentials not configured — skipping ticket validation"
    return 0
  fi

  # Call Jira API to check ticket exists and get status
  local response
  response=$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Basic $(echo -n "$JIRA_EMAIL:$JIRA_API_TOKEN" | base64)" \
    -H "Accept: application/json" \
    "$JIRA_BASE_URL/rest/api/3/issue/$TICKET_ID" 2>/dev/null || echo -e "\n000")

  local http_code
  http_code=$(echo "$response" | tail -1)
  local body
  body=$(echo "$response" | sed '$d')

  if [ "$http_code" = "404" ]; then
    echo "❌ COMMIT REJECTED: Jira ticket $ticket_id does not exist"
    echo "   Create the ticket first: $JIRA_BASE_URL/secure/CreateIssue.jspa?pid=$PROJECT_ID"
    return 1
  elif [ "$http_code" != "200" ]; then
    echo "⚠️  Jira API returned HTTP $http_code — skipping ticket validation"
    return 0
  fi

  # Extract status from JSON response
  local status
  status=$(echo "$body" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    fields = data.get('fields', {})
    status = fields.get('status', {})
    print(status.get('name', 'Unknown'))
except:
    print('Unknown')
" 2>/dev/null || echo "Unknown")

  # Reject if ticket is Done or Closed
  case "$status" in
    Done|Closed|Archived|Cancelled|Resolved)
      echo "❌ COMMIT REJECTED: Jira ticket $ticket_id is in status '$status'"
      echo "   Reopen the ticket or create a new one for this work."
      echo "   Ticket: $JIRA_BASE_URL/browse/$ticket_id"
      return 1
      ;;
    *)
      echo "✅ Jira ticket $ticket_id validated (status: $status)"
      return 0
      ;;
  esac
}

# ================================================================
# STEP 1: Secret scan on staged files
# ================================================================
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -n "$STAGED_FILES" ]; then
  SECRET_PATTERNS=(
    'ATATT3[A-Za-z0-9_-]+'
    'sk-[A-Za-z0-9]{48}'
    'ghp_[A-Za-z0-9]{36}'
    'API_KEY\s*[:=]\s*["'"'"'][A-Za-z0-9]{20,}["'"'"']'
    'SECRET\s*[:=]\s*["'"'"'][A-Za-z0-9]{20,}["'"'"']'
    'TOKEN\s*[:=]\s*["'"'"'][A-Za-z0-9]{20,}["'"'"']'
  )

  for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
      for pattern in "${SECRET_PATTERNS[@]}"; do
        if git show ":$file" 2>/dev/null | grep -qE "$pattern"; then
          echo "❌ COMMIT REJECTED: Potential secret in $file ($pattern)"
          exit 1
        fi
      done
    fi
  done
fi

# ================================================================
# STEP 2: Jira ticket validation (pre-dispatch gate)
# ================================================================
load_jira_env

# Extract Jira ticket from commit message (if prepare-commit-msg didn't run)
# Try branch name first, then staged commit message file
BRANCH=$(git rev-parse --abbrev-ref HEAD)
TICKET_ID=$(echo "$BRANCH" | grep -oE 'KAN-[0-9]+' | head -1 || true)

# If no ticket in branch, check if there's a COMMIT_EDITMSG already
if [ -z "$TICKET_ID" ]; then
  COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
  if [ -f "$COMMIT_MSG_FILE" ]; then
    TICKET_ID=$(cat "$COMMIT_MSG_FILE" | grep -oE 'KAN-[0-9]+' | head -1 || true)
  fi
fi

# Validate ticket if found
if [ -n "${TICKET_ID:-}" ]; then
  validate_jira_ticket "$TICKET_ID" || exit 1
else
  echo "⚠️  No Jira ticket detected — skipping ticket validation"
  echo "   Branch: $BRANCH"
  echo "   Format: feature/KAN-123-description"
fi

echo "✅ Pre-commit: all checks passed"
exit 0
